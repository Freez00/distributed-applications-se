@model ReservationDetailsViewModel

@{
    ViewData["Title"] = "Reservation Details";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-uppercase text-secondary fw-semibold mb-2">Reservation</p>
                <h1 class="h3">@Model.Reservation.ReservationCode</h1>
                <dl class="row mb-0">
                    <dt class="col-5">Status</dt>
                    <dd class="col-7">@Model.Reservation.Status</dd>
                    <dt class="col-5">Flight</dt>
                    <dd class="col-7">@Model.Flight?.FlightNumber</dd>
                    <dt class="col-5">Route</dt>
                    <dd class="col-7">@Model.DepartureAirport?.Code - @Model.DepartureAirport?.City -> @Model.ArrivalAirport?.Code - @Model.ArrivalAirport?.City</dd>
                    <dt class="col-5">Departure</dt>
                    <dd class="col-7">@Model.Flight?.DepartureTime.ToLocalTime().ToString("dd MMM HH:mm")</dd>
                    <dt class="col-5">Passengers</dt>
                    <dd class="col-7">@Model.Reservation.PassengerCount</dd>
                    <dt class="col-5">Total</dt>
                    <dd class="col-7">@Model.Reservation.TotalPrice.ToString("0.00") @Model.Reservation.Currency</dd>
                </dl>
                @if (Model.HasCompletedPayment)
                {
                    <div class="alert alert-success mt-3 mb-0">Payment completed. No additional payments are needed.</div>
                }
                @if (Model.CompletedPayment is not null)
                {
                    <form asp-controller="Payments" asp-action="Refund" asp-route-paymentId="@Model.CompletedPayment.Id" asp-route-reservationId="@Model.Reservation.Id" method="post" class="mt-3">
                        <button class="btn btn-outline-danger w-100" onclick="return confirm('Refund this payment and cancel the reservation?')">Refund payment</button>
                    </form>
                }
                else if (Model.CanRecordPayment)
                {
                    <a asp-controller="Payments" asp-action="Create" asp-route-reservationId="@Model.Reservation.Id" class="btn btn-primary w-100 mt-3">
                        Record payment
                    </a>
                }
                else
                {
                    <div class="alert alert-secondary mt-3 mb-0">Payments are not available for this reservation status.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5">Tickets</h2>
                @if (!Model.Tickets.Any())
                {
                    <p class="text-muted mb-0">No tickets found.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Passenger</th>
                                    <th>Document</th>
                                    <th>Seat</th>
                                    <th>Fare</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.Tickets)
                                {
                                    <tr>
                                        <td>@ticket.PassengerFirstName @ticket.PassengerLastName</td>
                                        <td>@ticket.PassengerDocumentNumber</td>
                                        <td>@(ticket.SeatNumber ?? "-")</td>
                                        <td>@ticket.FareClass</td>
                                        <td>@ticket.Price.ToString("0.00") @ticket.Currency</td>
                                        <td>@ticket.TicketStatus</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Payments</h2>
                @if (!Model.Payments.Any())
                {
                    <p class="text-muted mb-0">No payment attempts yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Amount</th>
                                    <th>Method</th>
                                    <th>Status</th>
                                    <th>Paid at</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>@(payment.TransactionReference ?? "-")</td>
                                        <td>@payment.Amount.ToString("0.00") @payment.Currency</td>
                                        <td>@payment.PaymentMethod</td>
                                        <td>@payment.PaymentStatus</td>
                                        <td>@(payment.PaidAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
