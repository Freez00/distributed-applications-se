@model AdminPaymentIndexViewModel

@{
    ViewData["Title"] = "Admin Payments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Payments</h1>
    <a asp-action="Create" class="btn btn-primary">Create payment</a>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-2">
            <label asp-for="ReservationId" class="form-label">Reservation</label>
            <select asp-for="ReservationId" class="form-select">
                <option value="">All</option>
                @foreach (var reservation in Model.Reservations)
                {
                    <option value="@reservation.Id">@reservation.ReservationCode</option>
                }
            </select>
        </div>
        <div class="col-md-3"><label asp-for="TransactionReference" class="form-label"></label><input asp-for="TransactionReference" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" class="form-select"><option value="">All</option><option>Card</option><option>BankTransfer</option><option>Cash</option></select></div>
        <div class="col-md-2"><label asp-for="PaymentStatus" class="form-label"></label><select asp-for="PaymentStatus" class="form-select"><option value="">All</option><option>Pending</option><option>Completed</option><option>Failed</option><option>Refunded</option></select></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Reference</th><th>Reservation</th><th>Amount</th><th>Method</th><th>Status</th><th>Created</th><th></th></tr></thead>
            <tbody>
                @foreach (var payment in Model.Results.Items)
                {
                    var reservationCode = Model.Reservations.FirstOrDefault(x => x.Id == payment.ReservationId)?.ReservationCode ?? $"#{payment.ReservationId}";

                    <tr>
                        <td>@(payment.TransactionReference ?? "-")</td>
                        <td>@reservationCode</td>
                        <td>@payment.Amount.ToString("0.00") @payment.Currency</td>
                        <td>@payment.PaymentMethod</td>
                        <td>@payment.PaymentStatus</td>
                        <td>@payment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@payment.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this payment?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
