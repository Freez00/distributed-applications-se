@model PagedResult<FlightResponse>

@{
    ViewData["Title"] = "Admin Flights";
    var airports = ViewBag.Airports as IReadOnlyCollection<AirportResponse> ?? Array.Empty<AirportResponse>();
    var aircraftList = ViewBag.Aircraft as IReadOnlyCollection<AircraftResponse> ?? Array.Empty<AircraftResponse>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Flights</h1>
    <a asp-action="Create" class="btn btn-primary">Create flight</a>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-2"><label class="form-label">Flight</label><input name="flightNumber" value="@ViewBag.FlightNumber" class="form-control" /></div>
        <div class="col-md-3">
            <label class="form-label">From</label>
            <select name="departureAirportId" class="form-select">
                <option value="">Any airport</option>
                @foreach (var airport in airports)
                {
                    <option value="@airport.Id">@airport.Code - @airport.City</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <select name="arrivalAirportId" class="form-select">
                <option value="">Any airport</option>
                @foreach (var airport in airports)
                {
                    <option value="@airport.Id">@airport.Code - @airport.City</option>
                }
            </select>
        </div>
        <div class="col-md-2"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All</option><option>Scheduled</option><option>Delayed</option><option>Cancelled</option><option>Arrived</option></select></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Flight</th><th>Route</th><th>Aircraft</th><th>Departure</th><th>Price</th><th>Status</th><th>Seats</th><th></th></tr></thead>
            <tbody>
                @foreach (var flight in Model.Items)
                {
                    var departure = airports.FirstOrDefault(x => x.Id == flight.DepartureAirportId);
                    var arrival = airports.FirstOrDefault(x => x.Id == flight.ArrivalAirportId);
                    var aircraft = aircraftList.FirstOrDefault(x => x.Id == flight.AircraftId);
                    <tr>
                        <td class="fw-semibold">@flight.FlightNumber</td>
                        <td>@(departure?.Code ?? $"#{flight.DepartureAirportId}") -> @(arrival?.Code ?? $"#{flight.ArrivalAirportId}")</td>
                        <td>@(aircraft?.RegistrationNumber ?? $"#{flight.AircraftId}")</td>
                        <td>@flight.DepartureTime.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@flight.BasePrice.ToString("0.00") @flight.Currency</td>
                        <td><span class="badge bg-secondary">@flight.Status</span></td>
                        <td>@flight.AvailableSeats</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@flight.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@flight.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@flight.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this flight?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
