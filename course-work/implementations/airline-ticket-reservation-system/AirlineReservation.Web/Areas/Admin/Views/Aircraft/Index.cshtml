@model PagedResult<AircraftResponse>

@{
    ViewData["Title"] = "Admin Aircraft";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Aircraft</h1>
    <a asp-action="Create" class="btn btn-primary">Create aircraft</a>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<form method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-3"><label class="form-label">Registration</label><input name="registrationNumber" value="@ViewBag.RegistrationNumber" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Model</label><input name="model" value="@ViewBag.Model" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Manufacturer</label><input name="manufacturer" value="@ViewBag.Manufacturer" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Active</label><select name="isActive" class="form-select"><option value="">All</option><option value="true">Active</option><option value="false">Inactive</option></select></div>
        <div class="col-md-1"><button class="btn btn-outline-primary w-100">Go</button></div>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Registration</th><th>Model</th><th>Manufacturer</th><th>Seats</th><th>Range</th><th>Year</th><th>Active</th><th></th></tr></thead>
            <tbody>
                @foreach (var aircraft in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@aircraft.RegistrationNumber</td>
                        <td>@aircraft.Model</td>
                        <td>@aircraft.Manufacturer</td>
                        <td>@aircraft.SeatCapacity</td>
                        <td>@aircraft.RangeKm km</td>
                        <td>@aircraft.ManufactureYear</td>
                        <td>@(aircraft.IsActive ? "Yes" : "No")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@aircraft.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@aircraft.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@aircraft.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this aircraft?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
