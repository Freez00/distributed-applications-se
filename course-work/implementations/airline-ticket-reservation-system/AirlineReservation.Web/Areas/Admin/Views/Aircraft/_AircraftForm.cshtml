@model AircraftCreateRequest

<form method="post" class="card border-0 shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-3"><label asp-for="RegistrationNumber" class="form-label"></label><input asp-for="RegistrationNumber" class="form-control" /><span asp-validation-for="RegistrationNumber" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="Manufacturer" class="form-label"></label><input asp-for="Manufacturer" class="form-control" /><span asp-validation-for="Manufacturer" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" /><span asp-validation-for="Model" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="ManufactureYear" class="form-label"></label><input asp-for="ManufactureYear" class="form-control" /><span asp-validation-for="ManufactureYear" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="SeatCapacity" class="form-label"></label><input asp-for="SeatCapacity" class="form-control" /><span asp-validation-for="SeatCapacity" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="RangeKm" class="form-label"></label><input asp-for="RangeKm" class="form-control" /><span asp-validation-for="RangeKm" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="LastMaintenanceDate" class="form-label"></label><input asp-for="LastMaintenanceDate" type="date" class="form-control" /><span asp-validation-for="LastMaintenanceDate" class="text-danger"></span></div>
            <div class="col-md-3 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>
