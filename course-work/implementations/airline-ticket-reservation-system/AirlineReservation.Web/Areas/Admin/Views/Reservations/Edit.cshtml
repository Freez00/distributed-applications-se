@model AdminReservationEditViewModel

@{
    ViewData["Title"] = "Edit Reservation";
}

<h1 class="h3 mb-3">Edit reservation @Model.ReservationCode</h1>

<form method="post" class="card border-0 shadow-sm">
    <div class="card-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ReservationCode" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Reservation.Status" class="form-label"></label>
                <select asp-for="Reservation.Status" class="form-select">
                    <option>Pending</option>
                    <option>Confirmed</option>
                    <option>Cancelled</option>
                    <option>Expired</option>
                </select>
                <span asp-validation-for="Reservation.Status" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Reservation.ExpiresAt" class="form-label"></label>
                <input asp-for="Reservation.ExpiresAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="Reservation.ExpiresAt" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary">Save</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
